{
  "name": "rustscrapr-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "cd apps/web && npm run dev",
    "build": "npm run build:wasm && npm run build:web",
    "build:wasm": "cd packages/wasm-scraper && wasm-pack build --target web",
    "build:web": "cd apps/web && npm run build"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
